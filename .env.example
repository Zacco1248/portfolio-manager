# ─────────────────────────────────────────────────────────────
# Portfolio Manager — konfiguracja
# Skopiuj do .env i uzupełnij. Klucze API są OPCJONALNE —
# bez nich aplikacja działa w trybie okrojonym, nigdy nie crashuje.
# ─────────────────────────────────────────────────────────────

# ── Serwer ───────────────────────────────────────────────────
# Port HTTP aplikacji (backend serwuje też zbudowany frontend).
PORT=8080
# Adres nasłuchu. 0.0.0.0 = dostępne w LAN i przez Tailscale.
HOST=0.0.0.0
NODE_ENV=production
# Strefa czasowa dla crona i granic dni giełdowych.
TZ=Europe/Warsaw

# ── Bezpieczeństwo (WYMAGANE) ────────────────────────────────
# Hasło do logowania. Jedyny użytkownik. Zmień przed uruchomieniem!
APP_PASSWORD=zmien-to-haslo
# Sekret do podpisywania ciasteczka sesji. Wygeneruj losowy ciąg:
#   openssl rand -hex 32
SESSION_SECRET=zmien-to-na-losowy-ciag-min-32-znaki
# Czas życia sesji w godzinach.
SESSION_TTL_HOURS=720
# Ustaw na true TYLKO jeśli aplikacja stoi za HTTPS (reverse proxy).
COOKIE_SECURE=false

# ── Baza danych ──────────────────────────────────────────────
# Ścieżka do pliku SQLite. W Dockerze montowana z ./data.
DATABASE_PATH=./data/portfolio.sqlite

# ── Ceny i kursy ─────────────────────────────────────────────
# Co ile minut odświeżać ceny w godzinach sesji giełdowej.
PRICE_REFRESH_MINUTES=15
# Godziny, w których cron odświeża ceny (czas lokalny, format H-H).
MARKET_HOURS=9-23
# Waluta bazowa portfela. Zmiana wymaga przeliczenia danych.
BASE_CURRENCY=PLN
# Wyłącz odpytywanie zewnętrznych API (tryb offline / testy).
DISABLE_EXTERNAL_FETCH=false

# ── Modele językowe (OPCJONALNE) ─────────────────────────────
# UWAGA: sam klucz NIE włącza żadnej funkcji AI. Każda z nich ma osobny
# przełącznik w Ustawieniach i domyślnie jest wyłączona — bez świadomej
# zgody aplikacja nie wysyła niczego na zewnątrz.
#
# Możesz podać jeden klucz albo oba i przełączać dostawcę w interfejsie.
# Klucz Anthropic: console.anthropic.com, OpenAI: platform.openai.com.
# W obu przypadkach warto ustawić limit wydatków.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modele startowe dla obu dostawców. Wybór modelu zmienisz też w Ustawieniach
# i to on ma pierwszeństwo — te wartości działają, dopóki nic tam nie wybierzesz.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-5-mini
# Maksymalna liczba newsów analizowanych przez AI w jednym cyklu (kontrola kosztów).
AI_NEWS_BATCH_LIMIT=25

# ── Telegram (OPCJONALNE) ────────────────────────────────────
# Bez tokenu: powiadomienia widoczne tylko w aplikacji.
# Token od @BotFather, chat_id od @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cron (wyłączanie pojedynczych zadań) ─────────────────────
CRON_PRICES_ENABLED=true
CRON_FX_ENABLED=true
CRON_SNAPSHOT_ENABLED=true
CRON_NEWS_ENABLED=true
CRON_ALERTS_ENABLED=true
